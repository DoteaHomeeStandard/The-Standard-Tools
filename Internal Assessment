<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>éStandard — Internal Evaluation Tool</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --oat: #F5F1EA;
  --taupe: #C7B8A4;
  --brown: #9A7B5C;
  --ink: #2A2420;
  --muted: #7A6E65;
  --line: #DDD8D0;
  --cream: #FAF8F4;
  --pass: #3A6B18;
  --fail: #7A2820;
  --pass-bg: #EDF3E6;
  --fail-bg: #F7EDEA;
}

body {
  font-family: 'Jost', sans-serif;
  font-weight: 300;
  background: #EDEBE6;
  color: var(--ink);
  min-height: 100vh;
  letter-spacing: 0.01em;
}

/* Layout */
.shell {
  max-width: 780px;
  margin: 0 auto;
  padding: 2rem 1.5rem 5rem;
}

/* Top bar */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  background: var(--ink);
  position: sticky;
  top: 0;
  z-index: 100;
}
.topbar-brand {
  font-family: 'Cormorant Garamond', serif;
  font-size: 13px;
  font-weight: 300;
  color: var(--taupe);
  letter-spacing: 0.12em;
}
.topbar-brand em { color: var(--oat); font-style: italic; }
.topbar-right { display: flex; gap: 0.75rem; align-items: center; }
.top-btn {
  padding: 7px 14px;
  font-family: 'Jost', sans-serif;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  border-radius: 3px;
  cursor: pointer;
  font-weight: 300;
  transition: all 0.2s;
  border: 0.5px solid;
}
.top-btn-primary { background: var(--brown); color: var(--oat); border-color: var(--brown); }
.top-btn-primary:hover { opacity: 0.85; }
.top-btn-ghost { background: transparent; color: var(--taupe); border-color: #4A4440; }
.top-btn-ghost:hover { border-color: var(--taupe); color: var(--oat); }

/* Cards */
.card {
  background: #fff;
  border-radius: 6px;
  border: 0.5px solid var(--line);
  margin-bottom: 1rem;
  overflow: hidden;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.25rem;
  border-bottom: 0.5px solid var(--line);
  background: var(--oat);
}
.card-title {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--brown);
  font-weight: 400;
}
.card-body { padding: 1.25rem; }

/* Setup section */
.setup-card {
  background: var(--ink);
  border-radius: 6px;
  padding: 1.25rem;
  margin-bottom: 1.5rem;
}
.setup-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
}
.setup-field label {
  display: block;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--taupe);
  margin-bottom: 5px;
  font-weight: 400;
}
.setup-field input, .setup-field select {
  width: 100%;
  font-family: 'Jost', sans-serif;
  font-size: 13px;
  font-weight: 300;
  padding: 8px 10px;
  border: 0.5px solid #4A4440;
  border-radius: 3px;
  background: #1E1A18;
  color: var(--oat);
  outline: none;
  transition: border-color 0.2s;
}
.setup-field input:focus, .setup-field select:focus { border-color: var(--brown); }
.setup-field select option { background: #1E1A18; }
.setup-row { grid-column: 1 / -1; }
.api-row {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.75rem;
  align-items: flex-end;
}
.api-row .setup-field { flex: 1; }
.ai-fill-btn {
  padding: 8px 16px;
  background: var(--brown);
  color: var(--oat);
  border: none;
  border-radius: 3px;
  font-family: 'Jost', sans-serif;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  font-weight: 300;
  transition: opacity 0.2s;
  height: 34px;
  flex-shrink: 0;
}
.ai-fill-btn:hover { opacity: 0.85; }
.ai-fill-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.ai-status {
  font-size: 11px;
  color: var(--taupe);
  margin-top: 0.5rem;
  min-height: 16px;
}

/* Section headers */
.section-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--brown);
  font-weight: 400;
  padding: 0.85rem 1.25rem;
  background: #F9F7F3;
  border-bottom: 0.5px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-pass-badge {
  font-size: 9px;
  letter-spacing: 0.12em;
  padding: 3px 10px;
  border-radius: 100px;
  font-weight: 400;
}
.section-pass-badge.pass { background: var(--pass-bg); color: var(--pass); }
.section-pass-badge.fail { background: var(--fail-bg); color: var(--fail); }
.section-pass-badge.pending { background: var(--oat); color: var(--muted); }

/* Checkbox groups */
.check-group { margin-bottom: 1.25rem; }
.check-group-label {
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 0.6rem;
  font-weight: 300;
}
.check-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.check-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border: 0.5px solid var(--line);
  border-radius: 3px;
  font-size: 12px;
  color: var(--muted);
  cursor: pointer;
  background: #fff;
  transition: all 0.15s;
  user-select: none;
}
.check-chip:hover { border-color: var(--taupe); }
.check-chip.active { border-color: var(--brown); background: var(--oat); color: var(--ink); }
.check-chip input { display: none; }

/* Radio single-select */
.radio-group { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 1.25rem; }
.radio-chip {
  padding: 6px 12px;
  border: 0.5px solid var(--line);
  border-radius: 100px;
  font-size: 11px;
  cursor: pointer;
  color: var(--muted);
  background: #fff;
  transition: all 0.15s;
  user-select: none;
}
.radio-chip:hover { border-color: var(--taupe); }
.radio-chip.active { border-color: var(--brown); background: var(--oat); color: var(--ink); }

/* Determination row */
.det-row {
  display: flex;
  gap: 8px;
  margin-top: 0.5rem;
}
.det-btn {
  flex: 1;
  padding: 10px;
  border: 0.5px solid var(--line);
  border-radius: 3px;
  font-family: 'Jost', sans-serif;
  font-size: 11px;
  letter-spacing: 0.12em;
  cursor: pointer;
  background: #fff;
  color: var(--muted);
  transition: all 0.15s;
  font-weight: 300;
}
.det-btn.active-pass { border-color: var(--pass); background: var(--pass-bg); color: var(--pass); }
.det-btn.active-fail { border-color: var(--fail); background: var(--fail-bg); color: var(--fail); }

/* Textareas */
.notes-area {
  width: 100%;
  font-family: 'Jost', sans-serif;
  font-size: 13px;
  font-weight: 300;
  padding: 10px 12px;
  border: 0.5px solid var(--line);
  border-radius: 3px;
  background: #fff;
  color: var(--ink);
  outline: none;
  resize: vertical;
  min-height: 80px;
  line-height: 1.6;
  transition: border-color 0.2s;
}
.notes-area:focus { border-color: var(--brown); }
.notes-label {
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 6px;
  margin-top: 1rem;
  display: block;
  font-weight: 400;
}

/* Closing formula */
.formula-box {
  background: var(--oat);
  border: 0.5px solid var(--line);
  border-radius: 4px;
  padding: 1rem;
  font-size: 13px;
  color: var(--ink);
  line-height: 1.7;
  margin-top: 0.75rem;
}
.formula-box em { font-style: italic; color: var(--brown); }

/* Result summary card */
.result-card {
  background: var(--ink);
  border-radius: 6px;
  padding: 1.5rem;
  margin-bottom: 1rem;
  color: var(--oat);
}
.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1rem;
  margin: 1rem 0;
}
.result-criterion { text-align: center; }
.result-criterion-name {
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--taupe);
  margin-bottom: 0.3rem;
}
.result-criterion-status {
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  font-weight: 300;
}
.result-criterion-status.pass { color: #7DC95E; }
.result-criterion-status.fail { color: #E07060; }
.result-overall {
  text-align: center;
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  font-weight: 300;
  padding-top: 1rem;
  border-top: 0.5px solid #4A4440;
}
.result-overall.pass { color: #7DC95E; }
.result-overall.fail { color: #E07060; }

/* Loading overlay */
.loading-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(42,36,32,0.7);
  z-index: 999;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 1rem;
}
.loading-overlay.visible { display: flex; }
.loading-spinner {
  width: 36px; height: 36px;
  border: 1.5px solid rgba(255,255,255,0.2);
  border-top-color: var(--taupe);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--taupe);
}

/* Divider */
.section-divider {
  height: 0.5px;
  background: var(--line);
  margin: 0.75rem 0;
}

/* Client email field */
.client-field {
  margin-bottom: 0.75rem;
}
.client-field label {
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  display: block;
  margin-bottom: 5px;
  font-weight: 400;
}
.client-field input {
  width: 100%;
  font-family: 'Jost', sans-serif;
  font-size: 14px;
  font-weight: 300;
  padding: 9px 12px;
  border: 0.5px solid var(--line);
  border-radius: 3px;
  background: #fff;
  color: var(--ink);
  outline: none;
  transition: border-color 0.2s;
}
.client-field input:focus { border-color: var(--brown); }

@media (max-width: 520px) {
  .setup-grid { grid-template-columns: 1fr; }
  .result-grid { grid-template-columns: 1fr; }
  .topbar { padding: 0.75rem 1rem; }
  .shell { padding: 1rem 1rem 4rem; }
}
</style>
</head>
<body>

<!-- Top bar -->
<div class="topbar">
  <div class="topbar-brand">Dotéa Home · <em>éStandard</em> Internal</div>
  <div class="topbar-right">
    <button class="top-btn top-btn-ghost" onclick="clearAll()">Clear</button>
    <button class="top-btn top-btn-primary" onclick="generatePDF()">Generate PDF Report</button>
  </div>
</div>

<div class="loading-overlay" id="loading-overlay">
  <div class="loading-spinner"></div>
  <div class="loading-text" id="loading-text">Applying the éStandard…</div>
</div>

<div class="shell">

  <!-- SETUP -->
  <div class="setup-card">
    <div class="setup-grid">
      <div class="setup-field">
        <label>Client Email</label>
        <input type="email" id="client-email" placeholder="client@email.com" />
      </div>
      <div class="setup-field">
        <label>Form Type</label>
        <select id="form-type" onchange="switchFormType()">
          <option value="universal">Universal (any category)</option>
          <option value="furniture">Furniture Specific</option>
        </select>
      </div>
      <div class="setup-field">
        <label>Brand</label>
        <input type="text" id="s-brand" placeholder="e.g. Restoration Hardware" />
      </div>
      <div class="setup-field">
        <label>Product Name</label>
        <input type="text" id="s-product" placeholder="e.g. Cloud Sectional" />
      </div>
      <div class="setup-field">
        <label>Category</label>
        <input type="text" id="s-category" placeholder="e.g. sofa, chandelier, faucet" />
      </div>
      <div class="setup-field">
        <label>Price</label>
        <input type="text" id="s-price" placeholder="$" />
      </div>
      <div class="setup-field setup-row">
        <label>Product URL</label>
        <input type="url" id="s-url" placeholder="https://..." />
      </div>
      <div class="setup-field setup-row">
        <label>Declared Materials / Finish</label>
        <input type="text" id="s-materials" placeholder="e.g. solid oak, oil finish" />
      </div>
      <div class="setup-field setup-row">
        <label>Manufacturer Claims (optional)</label>
        <input type="text" id="s-claims" placeholder="e.g. stain-resistant, solid hardwood frame" />
      </div>
    </div>
    <div class="api-row" style="justify-content:flex-end;">
      <button class="ai-fill-btn" id="ai-fill-btn" onclick="aiFill()">AI Pre-Fill ↓</button>
    </div>
    <div class="ai-status" id="ai-status"></div>
  </div>

  <!-- BEAUTY CONVICTION (from client intake) -->
  <div class="card">
    <div class="section-label">
      Section 4 — Beauty (Client Conviction)
      <span class="section-pass-badge pending" id="beauty-badge">Pending</span>
    </div>
    <div class="card-body">
      <p style="font-size:12px;color:var(--muted);margin-bottom:1rem;line-height:1.6;">Pulled from client intake. Score their responses below.</p>

      <div class="check-group">
        <div class="check-group-label">Q1 — If this piece were unavailable tomorrow:</div>
        <div class="radio-group" id="bq1">
          <div class="radio-chip" onclick="radioSelect('bq1',this,'A')" data-val="A">A — I'd find something similar</div>
          <div class="radio-chip" onclick="radioSelect('bq1',this,'B')" data-val="B">B — Mildly disappointed</div>
          <div class="radio-chip" onclick="radioSelect('bq1',this,'C')" data-val="C">C — Actively try to secure it</div>
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Q2 — Living with this piece for 10 years:</div>
        <div class="radio-group" id="bq2">
          <div class="radio-chip" onclick="radioSelect('bq2',this,'A')" data-val="A">A — I'll replace it eventually</div>
          <div class="radio-chip" onclick="radioSelect('bq2',this,'B')" data-val="B">B — I'm unsure</div>
          <div class="radio-chip" onclick="radioSelect('bq2',this,'C')" data-val="C">C — Can see it aging with the home</div>
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Q3 — If someone questioned this purchase:</div>
        <div class="radio-group" id="bq3">
          <div class="radio-chip" onclick="radioSelect('bq3',this,'A')" data-val="A">A — Second-guess myself</div>
          <div class="radio-chip" onclick="radioSelect('bq3',this,'B')" data-val="B">B — Defend it logically</div>
          <div class="radio-chip" onclick="radioSelect('bq3',this,'C')" data-val="C">C — Completely certain</div>
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Q4 — I am choosing this because:</div>
        <div class="radio-group" id="bq4">
          <div class="radio-chip" onclick="radioSelect('bq4',this,'A')" data-val="A">A — It fits the space</div>
          <div class="radio-chip" onclick="radioSelect('bq4',this,'B')" data-val="B">B — Meets my requirements</div>
          <div class="radio-chip" onclick="radioSelect('bq4',this,'C')" data-val="C">C — I genuinely love it</div>
        </div>
      </div>

      <div class="check-group-label" style="margin-bottom:6px;">Beauty Determination</div>
      <div class="det-row">
        <button class="det-btn" id="beauty-pass-btn" onclick="setDetermination('beauty','pass')">Pass (Mostly C)</button>
        <button class="det-btn" id="beauty-fail-btn" onclick="setDetermination('beauty','fail')">Does Not Pass (A or B majority)</button>
      </div>

      <span class="notes-label">Optional Note (1 sentence)</span>
      <textarea class="notes-area" id="beauty-notes" rows="2" placeholder="e.g. She loves it. That conviction is real and it meets the threshold."></textarea>
    </div>
  </div>

  <!-- DURABILITY -->
  <div class="card">
    <div class="section-label">
      Section 2 — Durability
      <span class="section-pass-badge pending" id="dur-badge">Pending</span>
    </div>
    <div class="card-body" id="dur-body">
      <!-- populated by switchFormType() -->
    </div>
  </div>

  <!-- WASHABILITY -->
  <div class="card">
    <div class="section-label">
      Section 3 — Washability
      <span class="section-pass-badge pending" id="wash-badge">Pending</span>
    </div>
    <div class="card-body" id="wash-body">
      <!-- populated by switchFormType() -->
    </div>
  </div>

  <!-- RESULT SUMMARY -->
  <div class="result-card" id="result-card">
    <div style="font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--taupe);margin-bottom:0.75rem;">éStandard Result</div>
    <div class="result-grid">
      <div class="result-criterion">
        <div class="result-criterion-name">Durable</div>
        <div class="result-criterion-status pending" id="res-dur">—</div>
      </div>
      <div class="result-criterion">
        <div class="result-criterion-name">Washable</div>
        <div class="result-criterion-status pending" id="res-wash">—</div>
      </div>
      <div class="result-criterion">
        <div class="result-criterion-name">Beautiful</div>
        <div class="result-criterion-status pending" id="res-beauty">—</div>
      </div>
    </div>
    <div class="result-overall pending" id="res-overall">Determination pending</div>
  </div>

  <!-- CLOSING -->
  <div class="card">
    <div class="section-label">Section 6 — Structured Closing</div>
    <div class="card-body">
      <div class="formula-box">
        Structurally, this piece demonstrates <em>[high/moderate/insufficient]</em> integrity under expected use. Surface performance is <em>[stable/manageable/vulnerable]</em> under normal maintenance. Based on your intake responses, aesthetic conviction <em>[meets/does not meet]</em> the é Standard threshold. Therefore, this item <em>[passes/does not pass]</em> the é Standard.
      </div>
      <span class="notes-label">Your Closing (fill the formula above)</span>
      <textarea class="notes-area" id="closing-text" rows="4" style="min-height:100px;" placeholder="Structurally, this piece demonstrates…"></textarea>
    </div>
  </div>

</div>

<script>
// ─── State ────────────────────────────────────────────────────────────────────
const determinations = { dur: null, wash: null, beauty: null };
const beautyAnswers = { bq1: null, bq2: null, bq3: null, bq4: null };

// ─── Form type ────────────────────────────────────────────────────────────────
function switchFormType() {
  const type = document.getElementById('form-type').value;
  renderDurForm(type);
  renderWashForm(type);
}

function renderDurForm(type) {
  const el = document.getElementById('dur-body');
  if (type === 'furniture') {
    el.innerHTML = `
      <div class="check-group">
        <div class="check-group-label">Frame / Core Construction</div>
        <div class="check-grid" id="d-frame">
          ${chips(['Solid hardwood','Plywood core','MDF','Particleboard','Metal welded','Metal bolted','Mixed construction','Unknown'],'d-frame-')}
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Joinery / Assembly</div>
        <div class="check-grid" id="d-joinery">
          ${chips(['Mortise & tenon','Dowelled','Screwed','Knock-down hardware','Stapled','Glued only','Welded','Unknown'],'d-join-')}
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Stress Risk Points</div>
        <div class="radio-group" id="d-stress">
          ${radioChips(['Minimal','Moderate','Significant'],'d-stress')}
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Load Capacity</div>
        <div class="radio-group" id="d-load">
          ${radioChips(['Suitable for daily use','Suitable for light use','Decorative only'],'d-load')}
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">Failure Probability (5–10 yrs)</div>
        <div class="radio-group" id="d-fail">
          ${radioChips(['Low','Moderate','High'],'d-fail')}
        </div>
      </div>
      <div class="check-group-label" style="margin-bottom:6px;">Durability Determination</div>
      <div class="det-row">
        <button class="det-btn" id="dur-pass-btn" onclick="setDetermination('dur','pass')">Pass</button>
        <button class="det-btn" id="dur-fail-btn" onclick="setDetermination('dur','fail')">Does Not Pass</button>
      </div>
      <span class="notes-label">Structural Notes (3–5 sentences)</span>
      <textarea class="notes-area" id="dur-notes" rows="4" placeholder="e.g. The frame is solid hardwood with mortise and tenon joinery. This piece will outlast the room it lives in."></textarea>
    `;
  } else {
    el.innerHTML = `
      <div class="check-group">
        <div class="check-group-label">A. Core Integrity</div>
        <div class="radio-group" id="d-core">
          ${radioChips(['Solid, stable, engineered for load/use','Adequate but not overbuilt','Lightweight / thin components','Decorative-grade construction','Unknown / insufficient data'],'d-core')}
        </div>
      </div>
      <div class="check-group">
        <div class="check-group-label">B. Stress Tolerance</div>
        <div class="radio-group" id="d-stress">

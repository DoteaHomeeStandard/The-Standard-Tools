function chips(options, prefix) {
  return options.map((o,i) => `
    <label class="check-chip" id="${prefix}${i}">
      <input type="checkbox" />
      ${o}
    </label>
  `).join('');
}

function radioChips(options, group) {
  return options.map(o => `
    <div class="radio-chip" onclick="radioSelect('${group}',this,'${o}')" data-val="${o}">${o}</div>
  `).join('');
}

function attachRadioListeners() {
  // radio chips already use onclick
}

function radioSelect(group, el, val) {
  document.querySelectorAll('#' + group + ' .radio-chip').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  if (group.startsWith('bq')) {
    beautyAnswers[group] = val;
    autoScoreBeauty();
  }
}

function autoScoreBeauty() {
  const vals = Object.values(beautyAnswers).filter(Boolean);
  if (vals.length < 4) return;
  const cs = vals.filter(v => v === 'C').length;
  const pass = cs >= 3;
  setDetermination('beauty', pass ? 'pass' : 'fail');
}

// ─── Determinations ───────────────────────────────────────────────────────────
function setDetermination(section, val) {
  determinations[section] = val;
  const passBtn = document.getElementById(section + '-pass-btn');
  const failBtn = document.getElementById(section + '-fail-btn');
  if (!passBtn || !failBtn) return;

  passBtn.classList.remove('active-pass','active-fail');
  failBtn.classList.remove('active-pass','active-fail');
  if (val === 'pass') passBtn.classList.add('active-pass');
  else failBtn.classList.add('active-fail');

  // update badge
  const badge = document.getElementById(section === 'beauty' ? 'beauty-badge' : section + '-badge');
  if (badge) {
    badge.textContent = val === 'pass' ? 'Pass' : 'Does Not Pass';
    badge.className = 'section-pass-badge ' + (val === 'pass' ? 'pass' : 'fail');
  }

  updateResult();
}

function updateResult() {
  const d = determinations;
  const labels = { pass: 'Pass', fail: 'Does Not Pass', null: '—' };

  const durEl = document.getElementById('res-dur');
  const washEl = document.getElementById('res-wash');
  const beautyEl = document.getElementById('res-beauty');
  const overallEl = document.getElementById('res-overall');

  if (durEl) { durEl.textContent = labels[d.dur] || '—'; durEl.className = 'result-criterion-status ' + (d.dur || 'pending'); }
  if (washEl) { washEl.textContent = labels[d.wash] || '—'; washEl.className = 'result-criterion-status ' + (d.wash || 'pending'); }
  if (beautyEl) { beautyEl.textContent = labels[d.beauty] || '—'; beautyEl.className = 'result-criterion-status ' + (d.beauty || 'pending'); }

  if (d.dur && d.wash && d.beauty) {
    const allPass = d.dur === 'pass' && d.wash === 'pass' && d.beauty === 'pass';
    overallEl.textContent = allPass ? 'Passes the éStandard' : 'Does Not Pass the éStandard';
    overallEl.className = 'result-overall ' + (allPass ? 'pass' : 'fail');
  } else {
    overallEl.textContent = 'Determination pending';
    overallEl.className = 'result-overall pending';
  }
}

// ─── AI Pre-Fill ──────────────────────────────────────────────────────────────
async function aiFill() {
  const url = document.getElementById('s-url').value.trim();
  const brand = document.getElementById('s-brand').value.trim();
  const product = document.getElementById('s-product').value.trim();
  const category = document.getElementById('s-category').value.trim();
  const price = document.getElementById('s-price').value.trim();
  const materials = document.getElementById('s-materials').value.trim();
  const claims = document.getElementById('s-claims').value.trim();

  showLoading(true, 'Reading product page…');
  const btn = document.getElementById('ai-fill-btn');
  btn.disabled = true;
  document.getElementById('ai-status').textContent = '';

  let productText = null;
  if (url) {
    try {
      const res = await fetch('https://api.allorigins.win/get?url=' + encodeURIComponent(url));
      const data = await res.json();
      if (data.contents) {
        const doc = new DOMParser().parseFromString(data.contents, 'text/html');
        ['script','style','nav','footer','header','aside','iframe','noscript'].forEach(t => doc.querySelectorAll(t).forEach(e => e.remove()));
        // Only grab product-relevant text — title, description, specs
        const title = doc.querySelector('title')?.textContent || '';
        const metas = [...doc.querySelectorAll('meta[name="description"], meta[property="og:description"]')].map(m => m.content).join(' ');
        const body = (doc.body?.textContent || '').replace(/\s+/g,' ').trim();
        // Pull only first 2000 chars of body to avoid junk
        productText = ('Title: ' + title + '\nDescription: ' + metas + '\nPage content: ' + body).slice(0, 2500);
      }
    } catch(e) { /* continue without */ }
  }

  showLoading(true, 'Applying the éStandard…');

  const system = `You are a home goods evaluation engine for Dotéa Home. Assess furniture and home goods against three criteria and return structured JSON.

DURABLE — Will it hold up under daily family use for 5-10 years? Assess frame, joinery, material grade, repairability.
WASHABLE — Can the owner clean and maintain this themselves without professional help or special products?

Be direct and specific. State what you can determine from available information.

Return ONLY this JSON with no other text:
{"durPass":true,"durNotes":"3-4 sentences assessing structural durability","washPass":true,"washNotes":"3-4 sentences assessing surface and maintenance","closing":"Structurally, this piece demonstrates [high/moderate/insufficient] integrity under expected use. Surface performance is [stable/manageable/vulnerable] under normal maintenance. Based on intake responses, aesthetic conviction [meets/does not meet] the threshold. Therefore, this item [passes/does not pass] the e Standard."}`;

  let prompt = 'Apply the éStandard to this piece.\n\n';
  if (brand) prompt += 'Brand: ' + brand + '\n';
  if (product) prompt += 'Product: ' + product + '\n';
  if (category) prompt += 'Category: ' + category + '\n';
  if (price) prompt += 'Price: ' + price + '\n';
  if (materials) prompt += 'Declared materials: ' + materials + '\n';
  if (claims) prompt += 'Manufacturer claims: ' + claims + '\n';
  if (productText) prompt += '\nProduct information from retailer page:\n' + productText + '\n';
  prompt += '\nReturn only the JSON.';

  const proxyUrl = 'https://assessment.doteahome.workers.dev';

  async function callClaude(includePageText) {
    let p = 'Evaluate this home goods item.\n\n';
    if (brand) p += 'Brand: ' + brand + '\n';
    if (product) p += 'Product: ' + product + '\n';
    if (category) p += 'Category: ' + category + '\n';
    if (price) p += 'Price: ' + price + '\n';
    if (materials) p += 'Declared materials: ' + materials + '\n';
    if (claims) p += 'Manufacturer claims: ' + claims + '\n';
    if (url) p += 'Product URL: ' + url + '\n';
    if (includePageText && productText) p += '\nRetailer description:\n' + productText + '\n';
    p += '\nReturn only the JSON object.';

    const res = await fetch(proxyUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system,
        messages: [{ role: 'user', content: p }]
      })
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error.message);
    const raw = data.content.map(b => b.text || '').join('');
    const jsonMatch = raw.match(/\{[\s\S]*\}/);
    if (!jsonMatch) throw new Error('NONJSON:' + raw.slice(0, 80));
    return JSON.parse(jsonMatch[0]);
  }

  try {
    let result;
    try {
      result = await callClaude(true);
    } catch(e) {
      if (e.message.startsWith('NONJSON') || e.message.includes('cannot')) {
        // Retry without page content
        document.getElementById('ai-status').textContent = 'Retrying without page content…';
        result = await callClaude(false);
      } else {
        throw e;
      }
    }

    const durNotes = document.getElementById('dur-notes');
    if (durNotes) durNotes.value = result.durNotes || '';
    setDetermination('dur', result.durPass ? 'pass' : 'fail');

    const washNotes = document.getElementById('wash-notes');
    if (washNotes) washNotes.value = result.washNotes || '';
    setDetermination('wash', result.washPass ? 'pass' : 'fail');

    const closing = document.getElementById('closing-text');
    if (closing && result.closing) closing.value = result.closing;

    document.getElementById('ai-status').textContent = '✓ AI pre-fill complete. Review and edit each section before generating the report.';

  } catch(err) {
    document.getElementById('ai-status').textContent = '✗ Error: ' + err.message;
  } finally {
    showLoading(false);
    btn.disabled = false;
  }
}

function showLoading(visible, msg) {
  const el = document.getElementById('loading-overlay');
  el.classList.toggle('visible', visible);
  if (msg) document.getElementById('loading-text').textContent = msg;
}

// ─── PDF Generation ───────────────────────────────────────────────────────────
function generatePDF() {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'letter' });

  const brand    = document.getElementById('s-brand').value.trim() || '—';
  const product  = document.getElementById('s-product').value.trim() || '—';
  const category = document.getElementById('s-category').value.trim() || '—';
  const price    = document.getElementById('s-price').value.trim() || '—';
  const materials= document.getElementById('s-materials').value.trim() || '—';
  const claims   = document.getElementById('s-claims').value.trim() || '—';
  const durNotes = document.getElementById('dur-notes')?.value.trim() || '—';
  const washNotes= document.getElementById('wash-notes')?.value.trim() || '—';
  const beautyNotes = document.getElementById('beauty-notes')?.value.trim() || '';
  const closing  = document.getElementById('closing-text')?.value.trim() || '—';

  const durPass   = determinations.dur === 'pass';
  const washPass  = determinations.wash === 'pass';
  const beautyPass= determinations.beauty === 'pass';
  const allPass   = durPass && washPass && beautyPass;

  // ── Constants ──
  const PW = 612, PH = 792;
  const ML = 48, MR = 48;
  const CW = PW - ML - MR;
  const LINE_H = 14;
  let y = 0;

  // ── Colors ──
  const C = {
    ink:     [42, 36, 32],
    brown:   [154, 123, 92],
    taupe:   [199, 184, 164],
    muted:   [140, 128, 118],
    line:    [221, 216, 208],
    oat:     [245, 241, 234],
    cream:   [252, 250, 247],
    white:   [255, 255, 255],
    passText:[38, 72, 18],
    failText:[96, 36, 24],
    passBg:  [232, 243, 222],
    failBg:  [248, 234, 230],
    passGreen:[80, 140, 40],
    failRed: [190, 70, 50]
  };

  // ── Helpers ──
  const fc = rgb => doc.setFillColor(...rgb);
  const tc = rgb => doc.setTextColor(...rgb);
  const dc = rgb => doc.setDrawColor(...rgb);

  function textBox(text, x, w, startY, fontSize, fontStyle, color, lineH) {
    doc.setFontSize(fontSize);
    doc.setFont('helvetica', fontStyle || 'normal');
    tc(color || C.ink);
    const lines = doc.splitTextToSize(text, w);
    doc.text(lines, x, startY);
    return lines.length * (lineH || LINE_H);
  }

  function rule(yy) {
    dc(C.line);
    doc.setLineWidth(0.5);
    doc.line(ML, yy, PW - MR, yy);
  }

  function sectionBlock(title, pass, notes) {
    // Calculate height needed
    doc.setFontSize(9);
    const noteLines = doc.splitTextToSize(notes || '—', CW - 32);
    const notesH = noteLines.length * LINE_H + 28;
    const totalH = 26 + notesH + 12;

    if (y + totalH > PH - 60) {
      doc.addPage();
      y = 48;
      pageHeader();
    }

    // Header bar — brown color
    fc(C.brown);
    dc(C.brown);
    doc.setLineWidth(0);
    doc.rect(ML, y, CW, 26, 'F');

    // Title
    doc.setFontSize(7.5);
    doc.setFont('helvetica', 'bold');
    tc([255, 255, 255]);
    doc.text(title.toUpperCase(), ML + 14, y + 16.5);

    // Status
    const statusLabel = pass ? 'PASS' : 'DOES NOT PASS';
    tc(pass ? [180, 230, 140] : [255, 180, 160]);
    doc.text(statusLabel, PW - MR - 14, y + 16.5, { align: 'right' });
    y += 26;

    // Notes box
    fc(C.cream);
    dc(C.line);
    doc.setLineWidth(0.5);
    doc.rect(ML, y, CW, notesH, 'FD');
    doc.setFontSize(9);
    doc.setFont('helvetica', 'normal');
    tc(C.ink);
    doc.text(noteLines, ML + 16, y + 16);
    y += notesH + 14;
  }

  function pageHeader() {
    doc.setFontSize(7);
    doc.setFont('helvetica', 'normal');
    tc(C.taupe);
    doc.text('DOTEA HOME  \u00B7  THE ESTANDARD', ML, 30);
    doc.text('CONFIDENTIAL', PW - MR, 30, { align: 'right' });
    rule(36);
  }

  // ── PAGE 1 ──────────────────────────────────────────────────────────────────

  // Header bar
  fc(C.ink);
  doc.rect(0, 0, PW, 78, 'F');

  // Wordmark
  doc.setFontSize(7.5);
  doc.setFont('helvetica', 'normal');
  tc(C.taupe);
  doc.text('DOTEA HOME', ML, 26);

  // Title
  doc.setFontSize(22);
  doc.setFont('helvetica', 'normal');
  tc(C.oat);
  doc.text('eStandard Evaluation', ML, 52);

  // Subtitle + date
  doc.setFontSize(7);
  doc.setFont('helvetica', 'normal');
  tc(C.taupe);
  doc.text('CONFIDENTIAL  \u00B7  CLIENT REPORT', ML, 66);
  const dateStr = new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});
  doc.text(dateStr, PW - MR, 66, { align: 'right' });

  y = 92;

  // ── PRODUCT SNAPSHOT ────────────────────────────────────────────────────────
  fc(C.oat);
  dc(C.line);
  doc.setLineWidth(0.5);
  doc.rect(ML, y, CW, 108, 'FD');

  // Label
  doc.setFontSize(7);
  doc.setFont('helvetica', 'bold');
  tc(C.brown);
  doc.text('PRODUCT SNAPSHOT', ML + 14, y + 14);

  // Divider inside box
  dc(C.line);
  doc.line(ML, y + 20, ML + CW, y + 20);

  // Fields — 2 columns
  const colW = CW / 2;
  const fields = [
    ['BRAND', brand], ['PRODUCT', product],
    ['CATEGORY', category], ['PRICE', price],
    ['DECLARED MATERIALS', materials], ['MANUFACTURER CLAIMS', claims]
  ];

  let fy = y + 32;
  fields.forEach((f, i) => {
    const fx = ML + 14 + (i % 2 === 1 ? colW : 0);
    if (i > 0 && i % 2 === 0) fy += 28;

    doc.setFontSize(6.5);
    doc.setFont('helvetica', 'bold');
    tc(C.muted);
    doc.text(f[0], fx, fy);

    doc.setFontSize(8.5);
    doc.setFont('helvetica', 'normal');
    tc(C.ink);
    const val = doc.splitTextToSize(f[1], colW - 28);
    doc.text(val[0] || '—', fx, fy + 10);
  });

  y += 120;

  // ── VERDICT BADGE ───────────────────────────────────────────────────────────
  const vBg  = allPass ? C.passBg  : C.failBg;
  const vTxt = allPass ? C.passText: C.failText;
  const vBdr = allPass ? C.passGreen: C.failRed;

  fc(vBg);
  dc(vBdr);
  doc.setLineWidth(1);
  doc.rect(ML, y, CW, 58, 'FD');

  doc.setFontSize(15);
  doc.setFont('helvetica', 'bold');
  tc(vTxt);
  doc.text(allPass ? 'Passes the eStandard' : 'Does Not Pass the eStandard', PW / 2, y + 24, { align: 'center' });

  doc.setFontSize(8);
  doc.setFont('helvetica', 'normal');
  tc(C.muted);
  doc.text(
    `Durable: ${durPass ? 'Pass' : 'Fail'}   \u00B7   Washable: ${washPass ? 'Pass' : 'Fail'}   \u00B7   Beautiful: ${beautyPass ? 'Pass' : 'Fail'}`,
    PW / 2, y + 42, { align: 'center' }
  );

  y += 72;

  // ── SECTIONS ────────────────────────────────────────────────────────────────
  sectionBlock('1 — Durability', durPass, durNotes);
  sectionBlock('2 — Washability', washPass, washNotes);

  const beautyText = beautyNotes || (beautyPass ? 'Strong aesthetic conviction. The client response meets the eStandard threshold.' : 'Conviction level does not meet the eStandard threshold.');
  sectionBlock('3 — Beauty (Client Conviction)', beautyPass, beautyText);

  // ── CLOSING ─────────────────────────────────────────────────────────────────
  doc.setFontSize(9);
  const closingLines = doc.splitTextToSize(closing, CW - 32);
  const closingH = closingLines.length * LINE_H + 28;

  if (y + closingH > PH - 60) { doc.addPage(); y = 48; pageHeader(); }

  fc(C.oat);
  dc(C.line);
  doc.setLineWidth(0.5);
  doc.rect(ML, y, CW, closingH, 'FD');
  doc.setFont('helvetica', 'normal');
  tc(C.ink);
  doc.text(closingLines, ML + 16, y + 18);
  y += closingH + 14;

  // ── NON-APPROVAL ────────────────────────────────────────────────────────────
  if (!allPass) {
    const naText = 'A non-approval applies only to this specific piece. It does not eliminate the category or the concept you are drawn to. If you wish to move forward, continue your search for a version that meets all three criteria. Approval is granted only when durability, washability, and beauty each pass.';
    doc.setFontSize(8);
    const naLines = doc.splitTextToSize(naText, CW - 32);
    const naH = naLines.length * 12 + 24;

    if (y + naH > PH - 60) { doc.addPage(); y = 48; pageHeader(); }

    fc(C.white);
    dc(C.line);
    doc.rect(ML, y, CW, naH, 'FD');
    tc(C.muted);
    doc.text(naLines, ML + 16, y + 15);
    y += naH + 14;
  }

  // ── PAGE FOOTER ─────────────────────────────────────────────────────────────
  rule(PH - 38);
  doc.setFontSize(7);
  doc.setFont('helvetica', 'normal');
  tc(C.taupe);
  doc.text('Dotea Home  \u00B7  eStandard Evaluation', ML, PH - 24);
  doc.text('doteahome.store', PW - MR, PH - 24, { align: 'right' });

  const filename = `eStandard-${(product||'Evaluation').replace(/\s+/g,'-')}-${new Date().toISOString().slice(0,10)}.pdf`;
  doc.save(filename);
}

// ─── Utilities ────────────────────────────────────────────────────────────────
function clearAll() {
  if (!confirm('Clear all fields?')) return;
  document.querySelectorAll('input[type=text], input[type=url], input[type=email], textarea').forEach(el => el.value = '');
  document.querySelectorAll('.radio-chip.active, .check-chip.active').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.det-btn').forEach(el => el.classList.remove('active-pass','active-fail'));
  Object.keys(determinations).forEach(k => determinations[k] = null);
  Object.keys(beautyAnswers).forEach(k => beautyAnswers[k] = null);
  ['dur-badge','wash-badge','beauty-badge'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.textContent = 'Pending'; el.className = 'section-pass-badge pending'; }
  });
  updateResult();
  document.getElementById('ai-status').textContent = '';
}

// ─── Init ─────────────────────────────────────────────────────────────────────
switchFormType();
</script>
